{
  "name": "radschnellverbindungen.info",
  "version": "0.3.0",
  "description": "The website for https://radschnellverbindungen.info.",
  "license": "AGPL-3.0",
  "author": "FixMyCity <hello@fixmycity.de>",
  "scripts": {
    "dev": "astro dev",
    "start": "bun run dev",
    "build": "astro build",
    "build:netlify": "bun run trassenscout:sync && bun run build",
    "build:local": "ASTRO_OUTPUT_MODE=static astro build",
    "preview": "ASTRO_OUTPUT_MODE=static astro preview --open",
    "astro": "astro",
    "generate-types": "astro sync --verbose --force && bun run generate-types:highlightError",
    "generate-types:highlightError": "echo -e '\\033[47;30mSHOW TYPES `any`\\033[0m' && cat ./.astro/astro/content.d.ts | grep -B 1 ': any'",
    "generate-types:full": "astro sync --verbose && bun run generate-types:highlightError && echo -e '\\033[47;30mSHOW FULL GENERATED TYPE FILE\\033[0m' && cat ./.astro/astro/content.d.ts",
    "type-check": "bun run --sequential type-check:*",
    "type-check:astro": "astro check",
    "type-check:tsc": "tsc --noEmit",
    "lint": "bun run --parallel lint:*",
    "lint:oxlint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint:steckbriefe": "bun ./scripts/lintSteckbriefeCollection.ts",
    "lint:map-images": "bun ./scripts/lintSteckbriefMapImages.ts",
    "lint-check": "bun run --parallel lint-check:*",
    "lint-check:oxlint": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "lint-check:steckbriefe": "bun ./scripts/lintSteckbriefeCollection.ts",
    "lint-check:map-images": "bun ./scripts/lintSteckbriefMapImages.ts",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test-run": "vitest run --passWithNoTests",
    "knip": "knip --config knip.config.mjs",
    "knip-warn": "knip --config knip.config.mjs || true",
    "check": "bun run --parallel type-check lint format test-run knip-warn",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run",
    "check-pre-push": "bun run --parallel type-check lint format test-run knip",
    "updatePackages:major": "bunx taze major --includeLocked --maturity-period 5 --write && bun install",
    "updatePackages:minor": "bunx taze minor --includeLocked --maturity-period 5 --write && bun install",
    "generateTsxFromSvg": "bun ./scripts/svgToTsx/svgToTsx.ts && bun run format",
    "export:steckbriefe": "bun ./scripts/exportSteckbriefeCsv/exportSteckbriefeCsv.ts",
    "trassenscout:update": "bun ./scripts/trassenscout/update.ts",
    "generate:map-images": "bun ./scripts/staticMapImages/generateStaticMapImages.ts",
    "trassenscout:sync": "bun run trassenscout:update && bun run generate:map-images",
    "bleach": "rm -rf node_modules/.astro && rm -rf node_modules/.bin && rm -rf node_modules/.vite && rm -rf .astro/ && rm -rf .netlify/ && rm -rf dist/ && bun install && bun run bleach:info",
    "bleach:info": "echo 'Also delete the browser cache, see https://github.com/vitejs/vite/discussions/17738#discussioncomment-10158746'",
    "bleach:all": "rm -rf node_modules/ && bun run bleach",
    "bleach:full": "rm bun.lock && bun run bleach:all",
    "prepare": "husky",
    "release": "gh pr create --base main --head develop --title \"Release $(date '+%Y-%m-%d')\" --body \"\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^6.0.1",
    "@astrojs/netlify": "^7.0.11",
    "@astrojs/react": "^5.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/ts-plugin": "^1.10.10",
    "@fontsource/overpass": "^5.2.8",
    "@googlemaps/polyline-codec": "^1.0.28",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-polygon": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@turf/square": "^7.4.0",
    "@turf/transform-scale": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "astro": "^6.4.2",
    "clsx": "^2.1.1",
    "maplibre-gl": "^5.24.0",
    "nuqs": "^2.9.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.2",
    "sharp": "^0.35.4",
    "svg-to-jsx": "^1.0.4",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web": "0.0.354",
    "babel-plugin-react-compiler": "^1.0.0",
    "browserslist": "^4.28.8",
    "browserslist-to-esbuild": "^2.1.1",
    "bun-types": "^1.3.14",
    "eslint-plugin-compat": "^7.0.2",
    "husky": "^9.1.7",
    "knip": "^6.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not op_mini all",
    "not kaios > 0"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "@keystatic/core@0.6.5": "patches/@keystatic%2Fcore@0.6.5.patch"
  },
  "trustedDependencies": [
    "astro",
    "eslint-plugin-compat"
  ]
}
