---
export const prerender = true

import { Radschnellweg } from '@components/SteckbriefPage/Radschnellweg'
import { getCollection } from 'astro:content'
import Layout from 'src/layouts/Layout.astro'
import { getSteckbriefStaticMapImage } from 'src/lib/steckbrief/staticMapImage'

export async function getStaticPaths() {
  const steckbriefe = await getCollection('steckbriefe')
  return steckbriefe.map((entry) => ({
    params: { id: entry.data.slug },
    props: { steckbrief: entry.data },
  }))
}

const { steckbrief } = Astro.props
---

<Layout
  title={'Steckbrief ' + steckbrief.title}
  image={getSteckbriefStaticMapImage(steckbrief.slug, steckbrief.geometry)}
  description={steckbrief.title}
>
  <Radschnellweg client:load steckbrief={steckbrief} />
</Layout>
