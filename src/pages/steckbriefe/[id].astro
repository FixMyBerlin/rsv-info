---
export const prerender = true

import { Radschnellweg } from '@components/SteckbriefPage/Radschnellweg'
import { getCollection, render } from 'astro:content'
import Layout from 'src/layouts/Layout.astro'
import { getSteckbriefStaticMapImage } from 'src/lib/steckbrief/staticMapImage'

export async function getStaticPaths() {
  const steckbriefe = await getCollection('steckbriefe')
  return steckbriefe.map((entry) => ({
    params: { id: entry.data.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content: DescriptionContent } = await render(entry)
---

<Layout
  title={'Steckbrief ' + entry.data.title}
  image={getSteckbriefStaticMapImage(entry.data.slug, entry.data.geometry)}
  description={entry.data.title}
>
  <Radschnellweg client:load steckbrief={entry.data}>
    <div class="prose">
      <DescriptionContent />
    </div>
  </Radschnellweg>
</Layout>
