---
export const prerender = true

import SteckbriefePage from '@components/SteckbriefePage/SteckbriefePage.astro'
import { getCollection } from 'astro:content'
import LayoutPage from 'src/layouts/LayoutPage.astro'
import {
  getFederalStateFilterData,
  getSteckbriefTeasers,
} from 'src/lib/steckbrief/getSteckbriefTeasers'

export async function getStaticPaths() {
  const steckbriefe = await getCollection('steckbriefe')
  const federalStateOptions = getFederalStateFilterData(steckbriefe)
  const uniqueFederalStates = Array.from(
    new Set(
      steckbriefe.flatMap((entry) => [entry.data.fromFederalState, entry.data.toFederalState]),
    ),
  ).filter(Boolean) as string[]

  return uniqueFederalStates.map((state) => {
    const filtered = steckbriefe.filter(
      (entry) => entry.data.fromFederalState === state || entry.data.toFederalState === state,
    )
    const rsvTeasers = getSteckbriefTeasers(filtered)
    return {
      params: {
        federalstate: state
          .toLocaleLowerCase()
          .replace(/ä/g, 'ae')
          .replace(/ö/g, 'oe')
          .replace(/ü/g, 'ue')
          .replace(/ß/g, 'ss'),
      },
      props: { rsvTeasers, state, federalStateOptions },
    }
  })
}

const { rsvTeasers, state, federalStateOptions } = Astro.props

const rsvCount = rsvTeasers.length > 1 ? ` ${rsvTeasers.length} ` : ' '

const title = `Radschnellverbindungen in ${state}`
const description = `Übersicht der aktuell ${rsvCount} geplanten Radschnellverbindungen in ${state}. Die Liste wird fortlaufend aktualisiert und ergänzt.`
---

<LayoutPage title={`Steckbriefe für ${state}`} description={description}>
  <SteckbriefePage
    rsvTeasers={rsvTeasers}
    headerDescription={description}
    headerTitle={title}
    currentFilter={state}
    federalStateOptions={federalStateOptions}
  />
</LayoutPage>
